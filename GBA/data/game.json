  "story": {
    "stages": [
      {
        "from": "Anna Nowak",
        "text": "Działka nasza! Liczę na|mocne fundamenty. Uważaj|na wilgoć w wykopie."
      },
      {
        "from": "Kierownik Marek",
        "text": "Stal jest, papierów brak.|Papierologia już czeka.|Trzymaj się planu!"
      },
      {
        "from": "Kierownik Marek",
        "text": "Szalunki stoją, beton|jedzie. Oby dostawa|dojechała na czas!"
      },
      {
        "from": "Anna Nowak",
        "text": "Prognoza: ulewa. Zdążysz|z dachem przed deszczem?|Kornik też nie śpi."
      },
      {
        "from": "Kierownik Marek",
        "text": "Stan surowy zamknięty!|Okna na wymiar, drzwi|też. Ulewa nie odpuszcza."
      },
      {
        "from": "Anna Nowak",
        "text": "Elektryk i hydraulik|w jednym pokoju. Co|może pójść nie tak? ;)"
      },
      {
        "from": "Kierownik Marek",
        "text": "Tynki schną tydzień.|Pleśń tylko na to czeka.|Wietrz i nie odpuszczaj."
      },
      {
        "from": "Anna Nowak",
        "text": "Już widzę nasz salon.|Tylko ten Termin... Dasz|radę, mamy harmonogram!"
      }
    ],
    "win": {
      "from": "Anna Nowak",
      "text": "Mamy klucze! Plan|pokonał chaos budowy.|Dziękujemy za wszystko!"
    },
    "lose": {
      "from": "Kierownik Marek",
      "text": "Budowa stoi. Spokojnie -|z lepszym planem pójdzie.|Wracamy na plac?"
    },
    "ngplus": {
      "from": "Anna Nowak",
      "text": "Znajomi też chcą dom.|Bierzesz kolejną budowę?|Termin już się szykuje."
    },
    "prologue": {
      "from": "Anna Nowak",
      "text": "Witaj na budowie! Plan|jest, ekipa też. Tylko|te problemy... Do dzieła!"
    },
    "prologueCaptions": [
